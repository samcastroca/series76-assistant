<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer (API 31+): same exclusions as backup_rules.xml (ADR 0007). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.json" />
        <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.json" />
        <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
