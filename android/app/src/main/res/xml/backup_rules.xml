<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API 30 and below). The session (token) and its Tink keyset never leave the
     device: a token must not travel in a backup, and the ciphertext is useless without the
     Android Keystore key, which is not backed up (ADR 0007). -->
<full-backup-content>
    <exclude domain="file" path="datastore/session.json" />
    <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
</full-backup-content>
