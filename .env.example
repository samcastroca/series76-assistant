# Postgres (docker compose)
POSTGRES_USER=series76
POSTGRES_PASSWORD=series76
POSTGRES_DB=series76

# Backend (async SQLAlchemy URL). From inside compose use host "db" instead of "localhost".
DATABASE_URL=postgresql+asyncpg://series76:series76@localhost:5432/series76

# Agent. LLM_PROVIDER=fake (default) needs no key: a scripted model that calls the real tools.
# openrouter is for the final validation only (human-run); google is for free manual checks and
# reuses GOOGLE_API_KEY below. Model IDs as the provider names them; none is hardcoded.
LLM_PROVIDER=fake
AGENT_MODEL=
FALLBACK_MODEL=
OPENROUTER_API_KEY=
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
MODEL_CALL_LIMIT=6
TOOL_CALL_LIMIT=6
HISTORY_TURNS=10
MAX_QUERY_CHARS=1000
# Daily LLM spend cap in USD (UTC day, summed from the cost the provider reports). Empty: no
# cap. Once reached, POST /api/conversation answers 503 budget_exceeded without calling the model.
DAILY_BUDGET_USD=

# Auth (ADR 0006). JWT_SECRET signs the access tokens (HS256): at least 32 characters, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`. The API refuses to start
# without it; left empty, docker compose supplies a development-only default. Set your own for
# anything shared.
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
# Failed logins allowed per client IP and email within the window, then 429 too_many_attempts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Passwords of the demo users created by the seed (engineer1@example.com, engineer2@example.com,
# developer@example.com). Only used when the user does not exist yet; left empty, docker compose
# uses the development defaults listed in the README.
SEED_ENGINEER1_PASSWORD=
SEED_ENGINEER2_PASSWORD=
SEED_DEVELOPER_PASSWORD=

# Ingest `extract` stage only (human-run). Provider: google (free AI Studio key) or openrouter
# (its own key, never OPENROUTER_API_KEY). Model ID as the provider names it.
INGEST_LLM_PROVIDER=google
INGEST_LLM_MODEL=
GOOGLE_API_KEY=
INGEST_OPENROUTER_API_KEY=

# Evaluation runner (backend/eval/run_eval.py). It reads the process environment; `make eval-full`
# loads this file for it, other runs need `uv run --env-file ../.env` or exported variables.
# It logs in with a developer account, because the trace endpoint needs that role.
# EVAL_API_URL=http://localhost:8000
# EVAL_EMAIL=developer@example.com
# EVAL_PASSWORD=   (`make eval-fast` defaults it to the compose development password)
# EVAL_TIMEOUT_S=180
# Optional: upload the dataset and log the run as a LangSmith experiment.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
